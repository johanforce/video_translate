# Optional default output directory.
# Leave empty to use ~/Videos/VideoTranslator.
VIDEO_TRANSLATOR_OUTPUT_DIR=

# Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# VieNeu runs locally through the vieneu SDK; no VieNeu API key is required.
VIENEU_DEFAULT_VOICE=Hải Đăng
